{
  "name": "smart-file-organizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:slow": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --lib five_thousand -- --ignored --nocapture",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:set": "node scripts/sync-version.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "check": "npm run version:check && npm run build && npm run test && npm run audit:source && cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "portable": "npm run tauri build -- --no-bundle && node scripts/package-portable.mjs",
    "setup": "npm run tauri build -- --bundles nsis && node scripts/package-setup.mjs",
    "release": "npm run tauri build -- --bundles nsis && node scripts/package-setup.mjs && node scripts/package-portable.mjs",
    "prune:artifacts": "node scripts/prune-artifacts.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/rethink-sans": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sweetalert2": "11.26.25",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  }
}
